# ==============================================================
# HRMS Environment Configuration (.env)
# ==============================================================

# Application Port and URL
PORT=3000
NODE_ENV=production
APP_URL=https://hr.amrodev.com

# PostgreSQL Database Settings
# Note: On Docker, if connecting to an existing container (e.g., afaq_postgres),
# you can use host.docker.internal, 172.17.0.1, or the container name if in the same docker network.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=hrms_db
DB_USER=hrms_admin
DB_PASSWORD=CHANGE_ME

# Alternatively, direct PostgreSQL connection string:
# DATABASE_URL=postgresql://hrms_admin:CHANGE_ME@host.docker.internal:5432/hrms_db

# AI Studio injected variables (Optional)
GEMINI_API_KEY=""
