# انسخ هذا الملف إلى .env ولا ترفع .env إلى Git. لا أسرار هنا.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# سلسلة اتصال PostgreSQL (استخدم كلمة مرور قوية خاصة بك)
DATABASE_URL=postgresql://hrms:CHANGE_ME@localhost:5432/hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hrms

# دور التطبيق hrms_app (يُضبط تلقائياً عند التهجير). أحرف وأرقام فقط ليصلح داخل رابط الاتصال.
APP_DB_PASSWORD=CHANGE_ME_alnum_only
# سر توقيع JWT: 32 حرفاً عشوائياً على الأقل (مثلاً: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_with_at_least_32_random_characters
# true خلف HTTPS (Cloudflare)؛ false فقط للتجربة عبر http غير محلي
COOKIE_SECURE=true
DEFAULT_COMPANY_SLUG=main
# للتطوير المحلي (CLI والترحيل): اتصال المالك
DATABASE_ADMIN_URL=postgresql://hrms:CHANGE_ME@localhost:5432/hrms

# تشفير الحقول الحساسة (AES-256-GCM). لكل مفتاح 32 بايت base64: openssl rand -base64 32
# ENCRYPTION_KEYS بصيغة id:base64 ويمكن إضافة مفاتيح قديمة بعد الفاصلة عند التدوير.
# ⚠️ احتفظ بنسخة من المفاتيح خارج الخادم؛ فقدانها يعني فقدان البيانات المشفّرة نهائياً.
ENCRYPTION_KEYS=k1:CHANGE_ME_base64_32_bytes
ENCRYPTION_KEY_ID=k1
# مفتاح مستقل لبصمات البحث؛ لا يُغيَّر بعد أول استخدام
ENCRYPTION_DIGEST_KEY=CHANGE_ME_base64_32_bytes

# العنوان العام للنظام (لرمز QR في الوثائق الصادرة)، مثل https://hr.example.com
PUBLIC_URL=

# ───── النسخ الاحتياطي (profile: backup) ─────
# عبارة التشفير في ملف (chmod 600) خارج git: sudo install -m 600 /dev/null /etc/hrms/backup.passphrase && openssl rand -base64 48 | sudo tee /etc/hrms/backup.passphrase >/dev/null
# BACKUP_PASSPHRASE_FILE=/etc/hrms/backup.passphrase   (مسار مطلق؛ احفظ نسخة منه خارج السيرفر!)
# BACKUP_HOUR_UTC=02
# KEEP_DAILY=7
# KEEP_WEEKLY=4
# KEEP_MONTHLY=6
# وجهة خارج السيرفر عبر rclone (مثل Backblaze B2 أو S3)؛ ضع rclone.conf في RCLONE_CONFIG_DIR
# BACKUP_REMOTE=b2:hrms-backups
# RCLONE_CONFIG_DIR=/etc/hrms/rclone

# ───── المراقبة (اختياري) ─────
# DSN مشروع GlitchTip: يرسل النظام نوع الخطأ والمكدس ومعرّف الطلب فقط (بلا جسم الطلب/ترويسات/مستخدم)
# SENTRY_DSN=https://KEY@glitchtip.example.com/1
# APP_RELEASE=

# مفتاح مدير المنصة لشاشة /platform (إنشاء الشركات): openssl rand -hex 32. اتركه فارغاً لتعطيلها.
PLATFORM_ADMIN_KEY=
